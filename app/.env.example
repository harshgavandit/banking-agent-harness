OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Bare gpt-4o-mini is also accepted and normalized to openai/gpt-4o-mini.
LLM_TIMEOUT_SECONDS=30
APPROVAL_TURNAROUND_HOURS=24

# Required for the hosted Vercel demo. Generate a random value of at least
# 32 characters and save it as a sensitive server-side environment variable.
# Never prefix credentials with NEXT_PUBLIC_ or expose them in browser code.
DEMO_SESSION_SECRET=

# Enable only after setting both Upstash credentials. No local fallback:
# a Redis outage blocks execution. Limits are fixed windows in seconds.
RATE_LIMIT_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
LLM_RATE_LIMIT_REQUESTS=60

# Optional. One of SUCCESS (default), FAILED, PENDING. Controls the
# simulated outcome of every confirmed transfer, for demoing outcome
# verification without changing any code. Restart adk web after changing it.
MOCK_TRANSACTION_OUTCOME=SUCCESS

# Optional. Session execution limits (see app/limits.py for defaults).
# Lower these to demo the harness blocking runaway/repeated behavior.
MAX_TOOL_CALLS=20
MAX_TRANSFER_ATTEMPTS=5
MAX_IDENTICAL_FAILURES=3
